# Exemplo de variÃ¡veis de ambiente (NÃƒO coloque segredos aqui)
# Copie para .env.local e preencha com seus valores.

# --- Next.js / Supabase (App) ---
# URL do projeto no Supabase (Settings â†’ API)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pÃºblica (anon) do Supabase (Settings â†’ API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role (APENAS server-side). NecessÃ¡ria para alguns scripts e rotas internas dev-only.
# Nunca exponha no client e nunca comite.
SUPABASE_SERVICE_ROLE_KEY=

# --- Dev-only ---
# Habilita rotas internas de teste de IA em desenvolvimento.
ALLOW_AI_TEST_ROUTE=false

# Habilita rotas internas de mock de UI em desenvolvimento.
ALLOW_UI_MOCKS_ROUTE=false

# --- Installer (ops only) ---
# Se INSTALLER_ENABLED nao estiver definido, o instalador fica liberado ate a primeira instalacao.
# Defina como false para desativar o instalador (recomendado apos o setup).
INSTALLER_ENABLED=false

# Token opcional para proteger o instalador (se definido, passa a ser obrigatorio).
INSTALLER_TOKEN=

# --- WhatsApp Integration ---
# Provider de WhatsApp: 'baileys' (free, WebSocket) ou 'meta' (official, requires approval)
# Padrão: baileys
WHATSAPP_PROVIDER=baileys

# Chave de encriptação para armazenar sessões Baileys localmente
# Gere com: openssl rand -base64 32
WHATSAPP_SESSION_ENCRYPTION_KEY=

# Secret para validar assinatura HMAC de webhooks Meta (P2, future)
# Encontrado em: Meta Business Settings  Apps  WhatsApp  Configuration
WHATSAPP_WEBHOOK_SECRET=

# Token de acesso Meta para API (P2, future)
# Formato: Bearer token from Meta
WHATSAPP_META_ACCESS_TOKEN=

# ID do número de telefone Meta (P2, future)
WHATSAPP_META_PHONE_NUMBER_ID=

# ID do app Meta (P2, future)
WHATSAPP_META_BUSINESS_ACCOUNT_ID=
